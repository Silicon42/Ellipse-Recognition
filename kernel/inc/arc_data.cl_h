#ifndef ARC_DATA_CL_H
#define ARC_DATA_CL_H

// dir stored in top bit, clamped count in bottom 7 bits
#define DIR_SHIFT		7
#define DIR_FLAG		(1 << DIR_SHIFT)
#define SEG_CNT_MASK	(DIR_FLAG - 1)
#define SEG_CNT_BIAS	3

typedef struct _arcdata{
	char4 tangents;
	short2 endpoint;
} __attribute__((aligned(8))) ArcData;

typedef union _rw_arcdata{
	int2 rw;
	ArcData ad;
} RW_ArcData;


#endif//ARC_DATA_CL_H