#ifndef ARC_DATA_CL_H
#define ARC_DATA_CL_H

#define DIR_SHIFT		14
#define SEG_CNT_MASK	((1 << DIR_SHIFT) - 1)
	// dir stored in top 2 bits, clamped count in bottom 14 bits
typedef struct _arcdata{
	char4 tangents;
	short2 endpoint;
} __attribute__((aligned(8))) ArcData;

typedef union _rw_arcdata{
	int2 rw;
	ArcData ad;
} RW_ArcData;


#endif//ARC_DATA_CL_H